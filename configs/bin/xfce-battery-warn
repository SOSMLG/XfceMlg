#!/usr/bin/env bash
# xfce-battery-warn — darkmatter battery notifier daemon (X) for xfce.
# Watches /sys/class/power_supply (no acpi dependency) and fires ONE
# dunst notification per threshold crossing: 20% (normal), 10% (normal),
# 5% (critical, persistent). Re-arms once charging back above 25%.
# Single instance enforced with a flock. Thresholds/paths are overridable
# through env vars so the logic is testable headless.
set -uo pipefail

# sensors first (env-overridable) so a battery-less box bails before locking
CAP_FILE="${CAP_FILE:-$(echo /sys/class/power_supply/BAT*/capacity 2>/dev/null | cut -d' ' -f1)}"
STATUS_FILE="${STATUS_FILE:-$(echo /sys/class/power_supply/BAT*/status 2>/dev/null | cut -d' ' -f1)}"
LOCK_FILE="${LOCK_FILE:-/tmp/xfce-battery-warn.lock}"
[ -n "$CAP_FILE" ] || exit 0   # no battery — nothing to guard

exec 9>"$LOCK_FILE"
flock -n 9 || exit 0   # one daemon only

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/xfce-battery-warn.level"
INTERVAL="${INTERVAL:-120}"
mkdir -p "$(dirname "$STATE")"

level() { cat "$STATE" 2>/dev/null || echo 100; }

while true; do
    cap=$(cat "$CAP_FILE" 2>/dev/null || echo 0)
    st=$(cat "$STATUS_FILE" 2>/dev/null || echo unknown)
    last=$(level)
    case "$st" in
        Charging|Full|Unknown)
            # (re)charging: re-arm the warnings once safely above 25%
            [ "$cap" -ge 25 ] && [ "$last" -ne 100 ] && echo 100 > "$STATE" ;;
        *)
            if   [ "$cap" -le 5  ] && [ "$last" -gt 5  ]; then
                notify-send -u critical -t 0 "Battery critical — ${cap}%" "Plug in NOW, the machine will hibernate shortly."
                echo 5  > "$STATE"
            elif [ "$cap" -le 10 ] && [ "$last" -gt 10 ]; then
                notify-send -u normal -t 8000 "Battery low — ${cap}%" "Plug in soon."
                echo 10 > "$STATE"
            elif [ "$cap" -le 20 ] && [ "$last" -gt 20 ]; then
                notify-send -u normal -t 8000 "Battery at ${cap}%"
                echo 20 > "$STATE"
            fi ;;
    esac
    sleep "$INTERVAL"
done