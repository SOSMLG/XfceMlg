#!/usr/bin/env bash
# xfce-theme-list — list theme palettes, marking the active one.
# Deployed by scripts/21-theme-tokyonight.sh from themes/ + the theme
# engine in ~/.config/devuan-xfce-setup/.
set -u

DEVX_CONFIG="${DEVX_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/devuan-xfce-setup}"
# shellcheck source=/dev/null
source "$DEVX_CONFIG/lib/theme-apply.sh"

current="$(theme_current)"
for id in $(theme_list); do
    if [ "$id" = "$current" ]; then
        printf ' * %s\n' "$id"
    else
        printf '   %s\n' "$id"
    fi
done