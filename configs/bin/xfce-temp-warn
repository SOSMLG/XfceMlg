#!/usr/bin/env bash
# xfce-temp-warn — darkmatter thermal notifier daemon for xfce.
# Watches the first /sys/class/thermal thermal zone (acpitz on ThinkPads)
# and fires ONE dunst notification per threshold crossing: 80°C (normal),
# 90°C (critical, persistent). Re-arms below 75°C. Single instance via
# flock; paths/interval overridable through env vars for headless tests.
set -uo pipefail

# sensor first (env-overridable) so a sensor-less box bails before locking
TZ_FILE="${TZ_FILE:-$(ls /sys/class/thermal/thermal_zone*/temp 2>/dev/null | head -1)}"
LOCK_FILE="${LOCK_FILE:-/tmp/xfce-temp-warn.lock}"
[ -n "$TZ_FILE" ] || exit 0   # no thermal sensor — nothing to guard

exec 9>"$LOCK_FILE"
flock -n 9 || exit 0   # one daemon only

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/xfce-temp-warn.level"
INTERVAL="${INTERVAL:-60}"
mkdir -p "$(dirname "$STATE")"

# start below the first warning threshold so a hot boot still fires
level() { cat "$STATE" 2>/dev/null || echo 70; }

while true; do
    t=$(cat "$TZ_FILE" 2>/dev/null || echo 0)   # millidegrees
    c=$((t / 1000))
    last=$(level)
    if   [ "$c" -ge 90 ] && [ "$last" -lt 90 ]; then
        notify-send -u critical -t 0 "CPU hot — ${c}°C" "Check fans / background load."
        echo 90 > "$STATE"
    elif [ "$c" -ge 80 ] && [ "$last" -lt 80 ]; then
        notify-send -u normal -t 8000 "CPU running warm — ${c}°C"
        echo 80 > "$STATE"
    elif [ "$c" -lt 75 ] && [ "$last" -ne 70 ]; then
        echo 70 > "$STATE"   # cooled down — re-arm
    fi
    sleep "$INTERVAL"
done