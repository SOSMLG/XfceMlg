#!/usr/bin/env bash
# xfce-raise <WM-class> <launch-cmd...> — focus-or-launch.
# If a visible window matching <class> exists (case-insensitive), activate it;
# otherwise run the launch command. Backs Super+f (Thunar), Super+e (codium),
# Super+w (firefox) so repeated presses focus the open window instead of
# stacking duplicates. Requires xdotool.
set -uo pipefail

[ $# -ge 2 ] || { echo "usage: xfce-raise <WM-class> <cmd...>" >&2; exit 2; }
CLASS="$1"
shift

ID="$(xdotool search --onlyvisible --class "$CLASS" 2>/dev/null | head -1)"
if [ -n "$ID" ]; then
    xdotool windowactivate --sync "$ID" 2>/dev/null || xdotool windowraise "$ID" 2>/dev/null
    exit 0
fi
exec "$@"