#!/usr/bin/env bash
# xfce-lock — idempotent screen lock for XFCE.
# Prefers light-locker (the Ctrl+Alt+l xflock4 target on this box); falls
# back to xfce4-screensaver, then xflock4. Lock-time hygiene: dunst paused,
# clipboard cleared. Waits for the lock screen to be dismissed, then
# restores dunst. Re-running while already locked is a no-op.
set -uo pipefail

LOCKED_FLAG="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/xfcemlg-lock.flag"
mkdir -p "$(dirname "$LOCKED_FLAG")" 2>/dev/null || LOCKED_FLAG="/tmp/xfcemlg-lock.$$.flag"

# locker_is_active — is a lock screen currently up?
#
# light-locker-command -q prints "The screensaver is active" when locked and
# "The screensaver is inactive" when not. A bare `grep -qi 'active'` matches
# BOTH, because the substring also lives inside "inactive" — so the old
# guard was unconditionally true and xfce-lock exited 0 without ever
# locking. Test for the negative form first.
#
# Both the idempotence check and the watch loop below MUST use this one
# function: fixing only the first site would make the loop spin forever.
locker_is_active() {
    command -v light-locker-command >/dev/null 2>&1 || return 1
    local out
    out="$(light-locker-command -q 2>/dev/null)" || return 1
    case "$out" in
    *inactive*) return 1 ;;
    *active*) return 0 ;;
    esac
    return 1
}

# -- idempotent: lock screen already up? just leave.
if locker_is_active; then
    exit 0
fi

# -- pick the locker
if command -v light-locker-command >/dev/null 2>&1; then
    LOCK_CMD="light-locker-command -l"
    WATCH=1
elif command -v xfce4-screensaver-command >/dev/null 2>&1; then
    LOCK_CMD="xfce4-screensaver-command -l"
    WATCH=0
elif command -v xflock4 >/dev/null 2>&1; then
    LOCK_CMD="xflock4"
    WATCH=0
else
    echo "xfce-lock: no screen locker found (install light-locker)." >&2
    exit 1
fi

# -- lock-time hygiene: notifications off, clipboard cleared
dunstctl set-paused true 2>/dev/null || true
if command -v xclip >/dev/null 2>&1; then printf '' | xclip -selection clipboard; fi
if command -v xsel  >/dev/null 2>&1; then printf '' | xsel -b; fi
touch "$LOCKED_FLAG"

eval "$LOCK_CMD" || true

# -- wait for the lock screen to be dismissed, then restore dunst.
# Bounded: a 12h cap means a wedged light-locker cannot leave dunst paused
# (and the flag file behind) for the rest of the session.
if [ "$WATCH" = 1 ]; then
    _waited=0
    while locker_is_active; do
        sleep 2
        _waited=$((_waited + 2))
        [ "$_waited" -ge 43200 ] && {
            echo "xfce-lock: lock screen still up after 12h — giving up the watch." >&2
            break
        }
    done
    unset _waited
fi
rm -f "$LOCKED_FLAG"
dunstctl set-paused false 2>/dev/null || true
exit 0