#!/usr/bin/env bash
# xfce-lock — idempotent screen lock for XFCE.
# Prefers light-locker (the Ctrl+Alt+l xflock4 target on this box); falls
# back to xfce4-screensaver, then xflock4. Lock-time hygiene: dunst paused,
# clipboard cleared. Waits for the lock screen to be dismissed, then
# restores dunst. Re-running while already locked is a no-op.
set -uo pipefail

LOCKED_FLAG="/tmp/xfce-lock.lock"

# -- idempotent: light-locker already active? just leave.
if command -v light-locker-command >/dev/null 2>&1 &&
    light-locker-command -q 2>/dev/null | grep -qi 'active'; then
    exit 0
fi

# -- pick the locker
if command -v light-locker-command >/dev/null 2>&1; then
    LOCK_CMD="light-locker-command -l"
    WATCH=1
elif command -v xfce4-screensaver-command >/dev/null 2>&1; then
    LOCK_CMD="xfce4-screensaver-command -l"
    WATCH=0
elif command -v xflock4 >/dev/null 2>&1; then
    LOCK_CMD="xflock4"
    WATCH=0
else
    echo "xfce-lock: no screen locker found (install light-locker)." >&2
    exit 1
fi

# -- lock-time hygiene: notifications off, clipboard cleared
dunstctl set-paused true 2>/dev/null || true
if command -v xclip >/dev/null 2>&1; then printf '' | xclip -selection clipboard; fi
if command -v xsel  >/dev/null 2>&1; then printf '' | xsel -b; fi
touch "$LOCKED_FLAG"

eval "$LOCK_CMD" || true

# -- wait for the lock screen to be dismissed, then restore dunst
if [ "$WATCH" = 1 ]; then
    while light-locker-command -q 2>/dev/null | grep -qi 'active'; do
        sleep 2
    done
fi
rm -f "$LOCKED_FLAG"
dunstctl set-paused false 2>/dev/null || true
exit 0