<?xml version="1.0" encoding="UTF-8"?>
<!-- xfcemlg — Thunar custom actions (Darkmatter rice).
     Existing actions kept; additions match the cross-WM muscle memory
     (VSCodium, VLC) and the installed toolset (xclip). -->
<actions>
<action>
<icon>utilities-terminal</icon>
<name>Open Terminal Here</name>
<unique-id>open-terminal-here</unique-id>
<command>exo-open --working-directory %f --launch TerminalEmulator</command>
<description>Open the default terminal in this folder</description>
<patterns>*</patterns>
<directories/>
</action>
<action>
<icon>utilities-terminal</icon>
<name>Open as Root</name>
<unique-id>open-as-root</unique-id>
<command>pkexec thunar %f</command>
<description>Open this folder with elevated privileges</description>
<patterns>*</patterns>
<directories/>
</action>
<action>
<icon>vscodium</icon>
<name>Open in VSCodium</name>
<unique-id>codium-folder</unique-id>
<command>codium --reuse-window "%f"</command>
<description>Open this folder in the existing VSCodium window</description>
<patterns>*</patterns>
<directories/>
</action>
<action>
<icon>multimedia-video-player</icon>
<name>Play with VLC</name>
<unique-id>vlc-play</unique-id>
<command>vlc --no-video-title-show "%f"</command>
<description>Play this file with VLC</description>
<patterns>*</patterns>
<audio-files/>
<video-files/>
</action>
<action>
<icon>multimedia-playlist</icon>
<name>Play Folder with VLC</name>
<unique-id>vlc-folder-playlist</unique-id>
<command>vlc --no-video-title-show "%f"</command>
<description>Play every media file in this folder</description>
<patterns>*</patterns>
<directories/>
</action>
<action>
<icon>edit-copy</icon>
<name>Copy Full Path</name>
<unique-id>copy-full-path</unique-id>
<command>sh -c 'printf "%s" "$1" | xclip -selection clipboard' _ "%f"</command>
<description>Copy the absolute path of the selection</description>
<patterns>*</patterns>
<directories/>
<text-files/>
<image-files/>
<audio-files/>
<video-files/>
</action>
<action>
<icon>system-run</icon>
<name>Make Executable</name>
<unique-id>make-executable</unique-id>
<command>chmod +x "%f"</command>
<description>Add the executable bit to this file</description>
<patterns>*</patterns>
<text-files/>
<image-files/>
<audio-files/>
<video-files/>
</action>
</actions>