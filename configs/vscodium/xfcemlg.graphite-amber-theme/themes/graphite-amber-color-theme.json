  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#79A9A6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "keyword.other",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E8A33D"
      }
    },
    {
      "scope": [
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.ternary",
        "keyword.operator.increment"
      ],
      "settings": {
        "foreground": "#E8A33D"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.quote",
        "string.template",
        "template-expression"
      ],
      "settings": {
        "foreground": "#D2992F"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#D2992F"
      }
    },
    {
      "scope": [
        "number"
      ],
      "settings": {
        "foreground": "#D2992F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "string.unquoted.js"
      ],
      "settings": {
        "foreground": "#D8D3C8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#D2992F"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "support.variable"
      ],
      "settings": {
        "foreground": "#D8D3C8"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.other.readwrite.global"
      ],
      "settings": {
        "foreground": "#E8A33D"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#D8D3C8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E8A33D"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#D2992F"
      }
    },
    {
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.type.declaration.body"
      ],
      "settings": {
        "foreground": "#9A9AA2"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#E8A33D"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C97064",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E8A33D",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#79A9A6"
      }
    },
    {
      "scope": [
        "markup.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#E8A33D",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.code"
      ],
      "settings": {
        "foreground": "#D2992F"
      }
    },
    {
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#E8A33D"
      }
    }
  ]
}